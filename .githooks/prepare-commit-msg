#!/usr/bin/env bash
#
# Git prepare-commit-msg hook (installed/updated by the /pre-commit skill).
# Re-run /pre-commit to regenerate or update this file.
#
# WHAT IT DOES: hard-stops a commit that is being made from a STALE
# commit-message draft, and warns when the draft no longer matches the index.
#
# WHY IT EXISTS: the agent-hands-the-commit-to-the-user flow writes a proposed
# message to $GIT_DIR/COMMIT_MSG_DRAFT, and the user later runs
# `git commit -F .git/COMMIT_MSG_DRAFT` in their own terminal. Between those two
# moments the repo can move underneath the draft — a commit lands, or files are
# staged/unstaged. The draft then describes something other than what is being
# committed, and nothing surfaces the mismatch: the commit just succeeds with a
# wrong message. Hit for real on 2026-07-29 in aws-resources. The root cause is
# that drafts get written from conversational memory instead of from the staged
# index; this hook turns the resulting silent mismatch into a hard stop.
#
# HOW IT WORKS: whoever writes the draft also writes a two-line sidecar,
# $GIT_DIR/COMMIT_MSG_DRAFT.base:
#     line 1: the HEAD sha the draft was composed against ("EMPTY" if unborn)
#     line 2: the index tree sha (`git write-tree`) at that moment — optional
# At commit time this hook BLOCKS when line 1 no longer matches HEAD, and WARNS
# when line 2 no longer matches the current index. The asymmetry is deliberate:
# an intervening commit means the draft describes history, which is always
# wrong; a changed index is often just "I staged one more file", so blocking
# there would train the user to reach for the bypass and hollow out the control.
#
# The stamp lives in a SIDECAR FILE, not inside the draft, and that is
# deliberate: `git commit -F <file>` uses cleanup mode `whitespace`, which does
# NOT strip "#" comment lines (verified on git 2.49.0). A "# base: <sha>" line
# inside the draft would therefore land verbatim in the commit message.
#
# BYPASS: ALLOW_STALE_DRAFT=1 git commit -F .git/COMMIT_MSG_DRAFT
# NOTE that `git commit --no-verify` does NOT bypass this hook — --no-verify
# skips pre-commit and commit-msg only (verified on git 2.49.0). The env var is
# the escape hatch.

set -uo pipefail

msg_file="${1:-}"
msg_source="${2:-}"

[ -n "$msg_file" ] && [ -r "$msg_file" ] || exit 0

git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
[ -n "$git_dir" ] || exit 0

draft="$git_dir/COMMIT_MSG_DRAFT"
base_file="$git_dir/COMMIT_MSG_DRAFT.base"

# No draft at all means this repo isn't using the draft flow. Stay out of the way.
[ -r "$draft" ] || exit 0

# Only message sources where the draft could plausibly be in play:
#   "message"  -> `-m` or `-F`. This is the draft flow, and it is ALSO what
#                 `git commit --amend -F <file>` reports (verified on git
#                 2.49.0) — amend is handled explicitly further down, not here.
#   ""         -> editor-driven commit. Retained for completeness only: this
#                 hook runs BEFORE the editor, so $msg_file holds git's template
#                 rather than the draft and the content match below never fires.
#                 A draft pasted into the editor by hand is therefore not
#                 covered, and cannot be.
# Skipped: "commit" (--amend --no-edit / -c / -C reuse an existing message),
# "merge", "squash", "template".
case "$msg_source" in
  message | '') ;;
  *) exit 0 ;;
esac

# --- Is this commit actually using the draft? --------------------------------
# Normalization trims trailing whitespace per line and surrounding blank lines.
# Comment lines are deliberately NOT stripped in the primary comparison: `-F`
# preserves them verbatim, so draft and message agree with comments intact.
# Stripping them from both sides would make a draft of "feat: x" + "# note"
# collide with an unrelated `git commit -m "feat: x"` and block it.
# Normalisation must absorb EVERYTHING git's cleanup does, because the draft is
# raw on disk while $msg_file has already been through it. Under cleanup mode
# `whitespace` — what -m and -F use — git strips per-line trailing whitespace,
# drops leading and trailing blank lines, AND collapses runs of blank lines to
# one. This function used to do the first two and not the third.
#
# That omission was a silent fail-open in this hook, present since it was
# written and unrelated to the draft-cleanup work that exposed it. A draft
# containing two consecutive blank lines — an ordinary thing in a message with
# paragraphs — arrived here already collapsed by git, did not compare equal to
# the draft on disk, and so was never recognised as "in use". The whole
# stale-draft check then exited 0 without running. Verified 2026-08-31 by
# capturing what git actually hands this hook: the blank run is already gone.
#
# So the draft this control most needed to catch was one written in the house
# style it is documented against. Widening the match can only make the check
# apply MORE often, which is the safe direction for a guard that had been
# quietly skipping.
#
# post-commit carries a byte-identical copy of this function, deliberately: the
# two hooks must agree on what "the draft was used" means, or one marks a draft
# in use and the other declines to clean it up.
normalize() {
  awk '
    { sub(/[[:space:]]+$/, ""); buf[++n] = $0 }
    END {
      first = 1;   while (first <= n && buf[first] == "") first++
      last  = n;   while (last >= first && buf[last] == "") last--
      blank = 0
      for (i = first; i <= last; i++) {
        if (buf[i] == "") { blank++; if (blank > 1) continue } else { blank = 0 }
        print buf[i]
      }
    }
  ' < "$1"
}

strip_comments() { printf '%s\n' "$1" | sed '/^#/d' | awk '
  { buf[++n] = $0 }
  END {
    first = 1;   while (first <= n && buf[first] == "") first++
    last  = n;   while (last >= first && buf[last] == "") last--
    blank = 0
    for (i = first; i <= last; i++) {
      if (buf[i] == "") { blank++; if (blank > 1) continue } else { blank = 0 }
      print buf[i]
    }
  }
'; }

draft_norm="$(normalize "$draft")"
msg_norm="$(normalize "$msg_file")"

# An empty draft would match an empty editor template and fire spuriously.
[ -n "$draft_norm" ] || exit 0

using_draft=0
if [ "$draft_norm" = "$msg_norm" ]; then
  using_draft=1
elif ! printf '%s\n' "$draft_norm" | grep -q '^#'; then
  # Fallback for configurations where git appends its own "#" template lines to
  # the message file. Applied ONLY when the draft itself contains no comment
  # lines, so stripping can affect the message side alone and cannot cause the
  # collision described above.
  [ "$(strip_comments "$msg_norm")" = "$draft_norm" ] && using_draft=1
fi

[ "$using_draft" -eq 1 ] || exit 0

# Leave a marker saying the draft is in play for THIS attempt, for post-commit
# to find. That hook deletes a committed draft so a leftover cannot later be
# mistaken for an unstamped one, but it runs after the fact and cannot see
# $msg_source — so it cannot distinguish a draft-driven commit from a
# cherry-pick, a merge, a squash, or `--amend --no-edit`. Re-deriving the answer
# from the committed message alone got it wrong: a cherry-pick of a commit whose
# message matched a pending draft deleted that draft (verified 2026-08-31). The
# source filtering above is the knowledge post-commit lacks, so it is recorded
# here rather than guessed there.
#
# Written BEFORE the stamp checks, so a blocked commit leaves a marker behind.
# That is deliberate and safe: post-commit consumes the marker unconditionally
# and still requires the committed message to match the draft, so a stale marker
# cannot make some later unrelated commit eat the draft.
: > "$git_dir/COMMIT_MSG_DRAFT.inuse" 2>/dev/null || true

# --- The draft IS in use. Now verify the stamp. ------------------------------
#
# The escape hatch is consulted FIRST, before any branch that can block. It used
# to sit after the missing-stamp check, which meant the block below printed
# "use ALLOW_STALE_DRAFT=1" and then ignored it — advice that does not work, in
# the one message a blocked author actually reads. Caught 2026-08-31 by the
# hook's own end-to-end test, immediately after that branch was changed from a
# warning into a block; while it was only a warning the ordering never mattered.
# NOTE the widened scope, since the variable's name no longer describes all of
# it: because this now sits above the missing- and truncated-stamp branches,
# ALLOW_STALE_DRAFT=1 waives the PROVENANCE check too, letting a hand-written
# unstamped draft through. That is intended — it is the single "I know what I am
# doing" escape for this hook, and --no-verify does not reach it — but it is
# broader than "stale", and the name is kept only because it is already in
# CLAUDE.md and in muscle memory.
if [ "${ALLOW_STALE_DRAFT:-}" = "1" ]; then
  echo "prepare-commit-msg: stale-draft check skipped (ALLOW_STALE_DRAFT=1)." >&2
  exit 0
fi

if [ ! -r "$base_file" ]; then
  # BLOCK, not warn. This used to `exit 0` after printing a warning, which
  # contradicted CLAUDE.md's own description of the control ("a draft written by
  # hand with no sidecar opts out of that protection, which is exactly how the
  # original failure went unnoticed"). A warning printed above a successful
  # commit is not a control: the commit lands, the terminal scrolls, and the
  # only path that reaches this branch is precisely the hand-written draft the
  # guard was built to catch. Writing the draft with commit_draft.py always
  # produces the stamp, so a missing stamp means the draft did not come from the
  # index — the exact provenance the check verifies.
  {
    echo ""
    echo "prepare-commit-msg: BLOCKED — committing from $draft, but there is no"
    echo "  stamp at $base_file, so the stale-draft check CANNOT run."
    echo ""
    echo "  Rewrite the draft from the staged index, which stamps it:"
    echo "    python3 ~/.claude/skills/pre-commit/references/commit_draft.py --message '...'"
    echo ""
    echo "  Or, if the draft really is current, say so for this commit only:"
    echo "    ALLOW_STALE_DRAFT=1 git commit -F $draft"
    echo ""
    echo "  (--no-verify does NOT skip this hook.)"
    echo ""
  } >&2
  exit 1
fi


# Line 1: HEAD sha. Line 2 (optional): index tree sha.
recorded_raw="$(sed -n '1p' "$base_file" | tr -d '[:space:]')"
recorded_tree="$(sed -n '2p' "$base_file" | tr -d '[:space:]')"

# A stamp file that exists but has no first line is a TRUNCATED stamp, not an
# absent one, and it reached the same silent `exit 0` as a missing sidecar did.
# That made a zero-byte COMMIT_MSG_DRAFT.base — trivially produced by an
# interrupted write — a permanent, invisible opt-out of the whole check. Treated
# the same as no stamp at all: block, with the same two remedies.
if [ -z "$recorded_raw" ]; then
  {
    echo ""
    echo "prepare-commit-msg: BLOCKED — the stamp at $base_file is empty or"
    echo "  truncated, so the stale-draft check CANNOT run."
    echo ""
    echo "  Rewrite the draft from the staged index, which re-stamps it:"
    echo "    python3 ~/.claude/skills/pre-commit/references/commit_draft.py --message '...'"
    echo ""
    echo "  Or, if the draft really is current:"
    echo "    ALLOW_STALE_DRAFT=1 git commit -F $draft"
    echo ""
  } >&2
  exit 1
fi

# Resolve to a full sha so a short sha in the sidecar still compares correctly.
# "EMPTY" is the sentinel for a draft written against an unborn HEAD.
if [ "$recorded_raw" = "EMPTY" ]; then
  recorded="EMPTY"
else
  recorded="$(git rev-parse --verify --quiet "${recorded_raw}^{commit}" 2>/dev/null || printf '%s' "$recorded_raw")"
fi
current="$(git rev-parse --verify --quiet HEAD 2>/dev/null || printf 'EMPTY')"

# --- Output hygiene ----------------------------------------------------------
# This hook's stderr is routinely captured (CI logs, agent transcripts,
# scrollback), so it is a real publication sink. Everything variable that gets
# printed — commit subjects AND file paths — goes through emit_scanned().
#
# Paths are included deliberately. An earlier version scanned only subjects, on
# the reasoning that filenames "cannot carry file contents". That was wrong in
# the one way that matters: AWS embeds the account ID directly in bucket names,
# so `aws-cloudtrail-logs-<id>-us-east-2` is a filename that IS an identifier —
# the exact shape scan_identifiers.py was written for.
SCANNER=""
for candidate in \
  "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/scan_identifiers.py" \
  "$HOME/.claude/skills/pre-commit/references/scan_identifiers.py"; do
  [ -r "$candidate" ] && { SCANNER="$candidate"; break; }
done

# Print text only if the identifier scan clears it. Withhold when the scan flags
# it OR when the scan cannot run at all — a missing scanner must not silently
# downgrade to printing unscanned content, which is exactly the bug the first
# version of this had: the `-n "$SCANNER"` guard fell through to the unscanned
# branch when the scanner was absent.
emit_scanned() {
  local text="$1" label="$2" count
  if [ -z "$text" ]; then
    echo "    (none)"
    return 0
  fi
  if [ -n "$SCANNER" ] && printf '%s\n' "$text" \
    | python3 "$SCANNER" --stdin --label "$label" >/dev/null 2>&1; then
    printf '%s\n' "$text" | sed 's/^/    /'
    return 0
  fi
  count="$(printf '%s\n' "$text" | grep -c . || true)"
  if [ -z "$SCANNER" ]; then
    echo "    ($count line(s) withheld — the identifier scanner was not found,"
    echo "     so this output could not be cleared for printing)"
  else
    echo "    ($count line(s) withheld — the identifier scan flagged them, and"
    echo "     this output stream may be captured)"
  fi
}

# --- Index drift: warn, never block ------------------------------------------
# Checked before the HEAD comparison so the warning still surfaces on the paths
# that exit 0 below.
warn_index_drift() {
  [ -n "$recorded_tree" ] || return 0
  local now_tree
  now_tree="$(git write-tree 2>/dev/null || true)"   # empty if the index is unmerged
  [ -n "$now_tree" ] || return 0
  [ "$now_tree" = "$recorded_tree" ] && return 0
  {
    echo ""
    echo "prepare-commit-msg: WARNING — the staged index changed since this draft"
    echo "  was written. The message may not describe what you are committing."
    echo ""
    echo "  What is staged now:"
    echo ""
    emit_scanned "$(git diff --cached --stat 2>/dev/null || true)" 'staged-paths'
    echo ""
    echo "  Committing anyway (this is a warning, not a block)."
    echo ""
  } >&2
}

# --- Amend using the draft that produced HEAD is legitimate ------------------
# `git commit --amend -F <draft>` reports source "message", indistinguishable
# from a fresh -F commit. Allow it when the draft is demonstrably the one that
# created the commit being amended: HEAD's own message equals the draft AND the
# stamp equals HEAD's parent.
#
# KNOWN LIMIT, accepted deliberately: re-running the same command against NEW
# work is indistinguishable from a legitimate amend using only hook state, so
# that case passes this check. The index-drift warning above is what surfaces
# it — which is why that warning must never be removed as redundant.
if [ "$recorded" != "$current" ] && [ "$current" != "EMPTY" ]; then
  # NOT the "EMPTY" sentinel: that means "unborn HEAD" on the recorded side, and
  # reusing it here would make a draft stamped EMPTY match any commit that
  # merely lacks a reachable parent — a root commit, or a shallow-clone graft
  # boundary. A value derived from $current can collide with neither.
  head_parent="$(git rev-parse --verify --quiet 'HEAD^' 2>/dev/null || printf 'NOPARENT-%s' "$current")"
  if [ "$recorded" = "$head_parent" ]; then
    head_msg_norm="$(git log -1 --format=%B HEAD 2>/dev/null | awk '
      { sub(/[[:space:]]+$/, ""); buf[++n] = $0 }
      END {
        first = 1;   while (first <= n && buf[first] == "") first++
        last  = n;   while (last >= first && buf[last] == "") last--
        for (i = first; i <= last; i++) print buf[i]
      }')"
    if [ "$head_msg_norm" = "$draft_norm" ]; then
      warn_index_drift
      exit 0
    fi
  fi
fi

if [ "$recorded" = "$current" ]; then
  warn_index_drift
  exit 0
fi

# --- Stale. Abort, and show enough to rewrite the message immediately. -------
{
  echo ""
  echo "prepare-commit-msg: BLOCKED — this commit message draft is STALE."
  echo ""
  echo "  The draft at $draft was written against a different HEAD than the one"
  echo "  you are committing onto, so it very likely describes work that has"
  echo "  already landed."
  echo ""
  echo "    draft written against : $recorded"
  echo "    HEAD is now           : $current"
  echo ""
  if [ "$recorded" != "EMPTY" ] && [ "$current" != "EMPTY" ] \
    && git merge-base --is-ancestor "$recorded" "$current" 2>/dev/null; then
    echo "  Commits that landed in between:"
    emit_scanned "$(git log --oneline --no-decorate "$recorded..$current" 2>/dev/null || true)" \
      'commit-subjects'
    echo ""
  fi
  echo "  What is actually staged right now:"
  echo ""
  emit_scanned "$(git diff --cached --stat 2>/dev/null || true)" 'staged-paths'
  echo ""
  echo "  Working tree status:"
  echo ""
  emit_scanned "$(git status --short 2>/dev/null || true)" 'worktree-paths'
  echo ""
  echo "  FIX: rewrite the draft from the staged index above (not from memory),"
  echo "  and restamp the sidecar in the same step:"
  echo ""
  echo "    python3 ~/.claude/skills/pre-commit/references/commit_draft.py --message '...'"
  echo ""
  echo "  If the draft really is correct as-is, bypass with:"
  echo ""
  echo "    ALLOW_STALE_DRAFT=1 git commit -F .git/COMMIT_MSG_DRAFT"
  echo ""
  echo "  (--no-verify does NOT bypass this hook; it skips pre-commit and"
  echo "  commit-msg only.)"
  echo ""
} >&2

exit 1

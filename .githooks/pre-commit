#!/usr/bin/env bash
#
# Git pre-commit hook (installed/updated by the /pre-commit skill).
# Re-run /pre-commit to regenerate or update this file.
#
# What it does:
#   1. Blocks commits to protected branches (main/master/develop/prod/production).
#   2. Blocks commits that introduce a "TEMP:" code comment.
#   3. Runs the repo's linter(s) against changed files only (staged + dirty).
#
# Bypass intentionally with: git commit --no-verify

set -uo pipefail
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- 1. Block commits on protected branches ----------------------------------
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo '')"
# Lowercased so 'Main' / 'MASTER' cannot slip past a case-sensitive match.
branch="$(printf '%s' "$branch" | tr '[:upper:]' '[:lower:]')"
case "$branch" in
  main|master|develop|prod|production)
    echo "pre-commit: direct commits to '$branch' are blocked. Use a feature branch." >&2
    exit 1
    ;;
esac

# --- 2. Block new "TEMP:" code comments --------------------------------------
# Scans only added lines in the staged diff. Matches a comment marker followed
# by optional whitespace and the marker word, as spelled in TEMP_RE below.
# Markers kept deliberately narrow (# // /* <!--) to avoid flagging SQL "--" and
# Lisp ";" on ordinary lines. A regex can't tell a comment from a string literal,
# so the marker word inside a quoted string can still trip it — rare; bypass if
# needed.
#
# DO NOT "helpfully" restore literal examples here. This comment used to
# illustrate the pattern with two real ones, which made the check match its own
# source: adding this file to a repo blocked the very commit adding it. It never
# surfaced while hooks lived untracked in .git/hooks/ and so were never staged;
# moving them to a tracked .githooks/ is what exposed it. Describe the pattern,
# do not write it.
TEMP_RE='(//|#|/\*|<!--)[[:space:]]*TEMP:'
# --no-ext-diff / --no-textconv are load-bearing, not cosmetic. A repo-configured
# textconv filter or an external diff driver rewrites what `git diff` PRINTS, so
# the text scanned below is no longer the text being staged: a filter that strips
# or transforms a line hides it from every check that reads this variable. Proven
# 2026-08-20 in aws-security-specialty-exam — with a textconv filter active the
# old form printed only a diff header and passed every check.
#
# The git call is also separated from the greps. Previously the whole pipeline
# carried `|| true`, which was there for grep's empty-input exit 1 but also
# swallowed a git failure: git dies, $added_lines is empty, and the checks below
# report clean. Fail-open, in a control whose job is to fail closed. Now only the
# greps are allowed to "fail".
if ! staged_diff="$(git --no-pager diff --cached --unified=0 --no-color \
    --no-ext-diff --no-textconv -- .)"; then
  echo "pre-commit: 'git diff --cached' failed; refusing to commit (fail closed)." >&2
  exit 1
fi
added_lines="$(printf '%s\n' "$staged_diff" | grep '^+' | grep -v '^+++' || true)"
if printf '%s\n' "$added_lines" | grep -Eq "$TEMP_RE"; then
  echo "pre-commit: found a 'TEMP:' comment in the staged changes:" >&2
  printf '%s\n' "$added_lines" | grep -En "$TEMP_RE" >&2
  echo "Remove the TEMP: comment(s) before committing (or use --no-verify to bypass)." >&2
  exit 1
fi

# --- 3. Lint changed files ----------------------------------------------------
# "Changed" = staged + unstaged-but-tracked-dirty files (Added/Copied/Modified/
# Renamed). Linters run against the working-tree state of these files (not the
# staged blob) — by design, so dirty unstaged edits are checked too. Untouched
# code is never linted.
changed_files="$(
  {
    git diff --name-only --diff-filter=ACMR
    git diff --cached --name-only --diff-filter=ACMR
  } | sort -u
)"
# Drop entries that no longer exist in the worktree (e.g. staged, then deleted),
# since a linter can't read a missing file and would error out.
changed_files="$(
  printf '%s\n' "$changed_files" | while IFS= read -r f; do
    [ -n "$f" ] && [ -e "$f" ] && printf '%s\n' "$f"
  done
)"

# >>> LINTER SECTION (customized per repo by the /pre-commit skill) <<<
# Generated BAML trees are excluded, matching this repo's previous hook.
#
# .githooks/ is excluded for a different reason: scan_identifiers.py is vendored
# byte-identical into every install and the test suite asserts it, so a repo that
# runs its own formatter over that file demands a formatting the file cannot
# have. The update would then only land with --no-verify, disabling the
# identifier scan and gitleaks on the very commit that updates them.
py_files="$(printf '%s\n' "$changed_files" \
  | grep -E '\.py$' \
  | grep -v '^\.githooks/' \
  | grep -v '^baml_client/' \
  | grep -v '^baml_src/' || true)"
if [ -n "$py_files" ]; then
  if command -v ruff >/dev/null 2>&1; then
    printf '%s\n' "$py_files" | tr '\n' '\0' | xargs -0 ruff check || {
      echo "pre-commit: ruff check failed. Fix the issues (or --no-verify to bypass)." >&2
      exit 1
    }
  fi
fi
# >>> END LINTER SECTION <<<

# --- 4. Sensitive-identifier scan --------------------------------------------
# Blocks cloud identifiers from entering committed files.
#
# WHY THIS EXISTS: a CFS doc containing an AWS account ID, 15 access-key IDs, and
# full ARNs was synced into a PUBLIC GitHub issue. It slipped through because the
# usual secrets rules cover *secrets* (keys, passwords) in *script output* — an
# account ID is an identifier, not a secret, and a committed doc is not output.
# Nothing automated checked. This is that check.
#
# MUST run BEFORE the CFS sync below: the sync publishes doc bodies to GitHub, so
# scanning afterwards would block the commit only after the content went public.
#
# Scans ADDED lines only, so pre-existing content never blocks an unrelated
# commit. The account-ID rule matches ANY 12-digit run bounded by non-digits.
# An earlier "must sit near the word account" rule was the central defect: it
# waved through aws-cloudtrail-logs-<id>-us-east-2, which is how AWS names its
# own buckets. Bare 12-digit runs are rare in prose (dates, versions, ports and
# hashes are other lengths; epoch-seconds is 10 and epoch-millis is 13), so the
# looser rule costs little. Documentation example IDs are excluded per match.
#
# Escape hatch: put the literal string `allow-identifier` on the same line.
# Matching lives in scan_identifiers.py (same directory as this hook), a single
# shared Python implementation. Three prior bash/ERE versions each shipped with
# false negatives: exclusions had to be applied by editing the line before
# matching, which destroyed adjacent real matches, and ERE cannot express the
# digit-boundary lookarounds the account-ID rule needs.
if [ -r "$HOOK_DIR/scan_identifiers.py" ]; then
  python3 "$HOOK_DIR/scan_identifiers.py" --staged-diff || exit 1
else
  # Fail closed: a missing scanner must not silently disable the control.
  echo "pre-commit: BLOCKED - $HOOK_DIR/scan_identifiers.py is missing or unreadable." >&2
  echo "  The cloud-identifier scan cannot run, so the commit is refused rather than" >&2
  echo "  silently proceeding unprotected. Restore it or use --no-verify knowingly." >&2
  exit 1
fi

# --- 4b. gitleaks secret scan -------------------------------------------------
# Division of labour: the scan above catches cloud IDENTIFIERS (account IDs,
# ARNs, principal IDs), which gitleaks does not cover because they are not
# secrets. gitleaks catches SECRETS (API keys, tokens, private keys). Regexes
# alone cannot close this; both layers are needed.
# `gitleaks git --staged`, not `gitleaks protect --staged`. protect is deprecated
# and is removed in gitleaks v9, and its removal would have been indistinguishable
# from a finding: an unknown subcommand also exits 1, and the output was sent to
# /dev/null, so a routine `brew upgrade` would have produced a permanent
# "BLOCKED — gitleaks found a secret" on every commit, with the suggested re-run
# command failing the same way. Found 2026-08-31 by review, before it bit.
#
# Output is captured rather than discarded so the two cases can be told apart.
# It is only ever PRINTED on the tool-error path, whose text carries no scanned
# content; a genuine finding still prints nothing but a pointer, because even
# --redact output is not something to spray into a terminal by default.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks_out="$(gitleaks git --staged --redact --no-banner --exit-code 1 2>&1)"; then
    if printf '%s' "$gitleaks_out" | grep -qiE 'unknown (command|flag|shorthand)|invalid argument'; then
      echo "pre-commit: BLOCKED — gitleaks ran but did not understand its arguments," >&2
      echo "  so secret scanning did NOT happen. This is a gitleaks version change," >&2
      echo "  not a finding. Re-run /pre-commit to regenerate this hook." >&2
      printf '%s\n' "$gitleaks_out" | sed 's/^/    /' >&2
      exit 1
    fi
    echo "pre-commit: BLOCKED — gitleaks found a secret in the staged changes." >&2
    echo "  Re-run for detail (output is redacted): gitleaks git --staged --redact --verbose" >&2
    exit 1
  fi
else
  # Fail CLOSED. This used to warn and continue, which disagreed with the
  # identifier scan directly above and was invisible precisely BECAUSE gitleaks
  # happens to be installed here: the branch never ran, so the gap could only
  # surface on a new machine, in CI, or after a PATH change — and it would
  # surface as "nothing happened" rather than as an error. A secret-scanning
  # control that quietly turns itself off is worse than no control at all,
  # because it still reads as protection. Found 2026-08-31 by review.
  echo "pre-commit: BLOCKED — gitleaks is not installed or not on PATH." >&2
  echo "  Secret scanning cannot run, so the commit is refused rather than" >&2
  echo "  silently proceeding unprotected." >&2
  echo "  Install it (brew install gitleaks), or commit with --no-verify" >&2
  echo "  knowingly." >&2
  exit 1
fi

exit 0
